#!name=CF IP 优选工具 (CFNB)
#!desc=v3.7.2-cfnb · cfnb IP 库（美/港/日/韩/新/台 4865 IP）· DIRECT 直连测速。扫描期间仅 speed.cloudflare.com 走固定地址并直连，结束恢复。需先停用原版「CF IP 优选工具」避免冲突。
#!version=3.7.2-cfnb
#!arguments=数量:100
#!arguments-desc=候选数量（1–500），网页会以该值为默认；网页可直接改。其他参数在工作台调整。

[Panel]
CF IP 优选工具 (CFNB) = title="CF IP 优选工具 (CFNB)",content="cfnb IP 库 · 美港日韩新台 · 逐 IP 实测",style=info,script-name=cfopt-panel,update-interval=5

[Script]
cfopt-dns = type=dns,script-path=https://raw.githubusercontent.com/zhiaon/Modules/main/surge_scripts/CFOptimizer-dns.js,script-update-interval=86400,engine=jsc,timeout=3
cfopt-panel = type=generic,script-path=https://raw.githubusercontent.com/ADfrenda/HG/main/CFOptimizer-cfnb.js,script-update-interval=86400,engine=jsc,timeout=10,argument="{{{数量}}}"
cfopt-page = type=http-request,pattern=^https?://cfoptimizer\.invalid/(?:\?.*)?$,script-path=https://raw.githubusercontent.com/ADfrenda/HG/main/cfopt-page-cfnb.js,script-update-interval=86400,engine=jsc,timeout=10,argument="{{{数量}}}"
cfopt-local = type=http-request,pattern=^https?://cfoptimizer\.invalid/api/,requires-body=true,max-size=4096,script-path=https://raw.githubusercontent.com/ADfrenda/HG/main/CFOptimizer-cfnb.js,script-update-interval=86400,engine=jsc,timeout=90,argument="{{{数量}}}"

[MITM]
hostname = %APPEND% cfoptimizer.invalid

[Host]
speed.cloudflare.com = script:cfopt-dns

[Rule]
DOMAIN,speed.cloudflare.com,DIRECT
